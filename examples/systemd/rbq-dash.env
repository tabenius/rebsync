# Settings for rbq-dash-pair.service; copy to ~/.config/rbq/dash.env.
RBQ_DASH=https://dash.ragbaz.cc
# The credential store defaults to ~/.config/rbq/credentials (set in the
# unit; systemd does not expand ~ or %h in this file). To move it, give an
# absolute path:
# RBQ_CREDENTIAL_STORE=/home/xyzzy/.config/rbq/credentials
# How the device appears in Dash's approval page and Paired devices.
RBQ_DASH_LABEL=xyzzy@kali
# secret-service: credentials encrypted with a key in your desktop keyring
# (needs an unlocked keyring in the session). On a headless machine use
# none: owner-only files, NOT encrypted at rest.
RBQ_CREDENTIAL_SEAL=secret-service
