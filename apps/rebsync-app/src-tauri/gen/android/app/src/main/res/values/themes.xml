<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.rbq_app" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/rebeqah_ink</item>
        <item name="android:statusBarColor">@color/rebeqah_ink</item>
        <item name="android:navigationBarColor">@color/rebeqah_ink</item>
    </style>

    <!-- Launch theme: RAGBAZ Rebeqah splash, then the app theme. -->
    <style name="Theme.Rebeqah.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/rebeqah_ink</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="windowSplashScreenAnimationDuration">600</item>
        <item name="postSplashScreenTheme">@style/Theme.rbq_app</item>
    </style>
</resources>
